{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PullStream",
  "version": "0.2.0",
  "identifier": "com.pullstream.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PullStream",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "publisher": "Substring Technologies",
    "copyright": "\u00a9 2026 Substring Technologies. All rights reserved.",
    "homepage": "https://substringtechnologies.com/",
    "shortDescription": "Fast parallel video and playlist downloader",
    "longDescription": "PullStream downloads videos and full playlists from 1,000+ websites, several at once, in any quality or as MP3/M4A audio.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "video"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwMDRGMkExREYwQjQ3ODAKUldTQVJ3dmZvZklFMEMxN2FWeG50bUZLVGh3Zk5XVmpUM1VPVU5TZTZrc0xUQll5OEdtWE5acjkK",
      "endpoints": [
        "https://github.com/substring-projects/Pullstream/releases/latest/download/latest.json"
      ]
    }
  }
}